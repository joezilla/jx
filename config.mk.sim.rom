# JX Monitor - Toolchain Configuration
# ======================================
# cpmsim testing variant of the ROM-capable build (config.mk.rom).
#
# Exercises the same BIOS_BASE/DATA_BASE relocation as config.mk.rom,
# but adds SIM_STUB=1 so cpmsim (which always starts execution at
# PC=0000H, with no equivalent of the 88-2SIOJP's hardware Jump-Start
# reset-vector redirect) has something valid to land on. The stub is
# NOT part of the real EPROM image - do not use SIM_STUB=1 when
# building the hex file to actually burn into a ROM.

# ----------------------------------------------
# z80pack Installation Path
# ----------------------------------------------
Z80PACK_DIR = ../z80pack

# ----------------------------------------------
# Assembler Configuration
# ----------------------------------------------
Z80ASM = $(Z80PACK_DIR)/z80asm/z80asm

# Assembler flags for 8080 mode
ASM_FLAGS_COMMON = -8 -e32 -l -T -sn -p0
ASM_FLAGS_BIN = $(ASM_FLAGS_COMMON) -fb
ASM_FLAGS_HEX = $(ASM_FLAGS_COMMON) -fh

# ----------------------------------------------
# Simulator Configuration
# ----------------------------------------------
SIMULATOR = $(Z80PACK_DIR)/cpmsim/cpmsim
SIM_FLAGS = -8 -m 00

# ----------------------------------------------
# Serial Configuration (cpmsim)
# ----------------------------------------------
#   SIO_DATA=01H  SIO_STATUS=00H  SIO_RX_MASK=0FFH  SIO_TX_MASK=0
#   Status port returns FFH (ready) or 00H (not ready).
#   No TX busy-wait needed.
SIO_NAME    = CPMSIM
SIO_DATA    = 01H
SIO_STATUS  = 00H
SIO_RX_MASK = 0FFH
SIO_TX_MASK = 0
SIO_8251   = 0

# SIO Channel B (disabled for simulator)
SIO2_DATA    = 0
SIO2_STATUS  = 0
SIO2_RX_MASK = 0

# ----------------------------------------------
# Optional Modules
# ----------------------------------------------
ENABLE_TERM = 0

# BASIC: 0=none, 1=4K BASIC (Palo Alto/Altair), 2=8K BASIC (IMSAI)
ENABLE_BASIC = 0

# Firmware update ('fw' command) - see config.mk.rom. Enabled here so its
# success/abort paths can be exercised under cpmsim; the real write-timing
# behavior can only be validated on real EEPROM hardware.
ENABLE_FWUPDATE = 1

# Simulator-only entry stub at 0000H (see header comment above).
SIM_STUB = 1

# ----------------------------------------------
# Memory Configuration
# ----------------------------------------------
MEM_SIZE = 64

# Same relocated placement as config.mk.rom: an 8K-aligned slot clear
# of Page Zero and VIDEO_BASE.
BIOS_BASE = 0E000H
DATA_BASE = 0100H
STACK_TOP = 0CC00H
# Firmware-update RAM layout (same as config.mk.rom - see its comment).
EEPROM_SIZE = 02000H
FW_STAGE_BASE = 02000H
FW_WRITER_BASE = 04000H

# ----------------------------------------------
# Video Configuration
# ----------------------------------------------
# Processor Technology VDM-1
# 64 columns x 16 rows at C000H
# Set VIDEO_BASE=0 to disable video support
VIDEO_BASE = 0CC00H
VIDEO_CTRL = 0C8H
VIDEO_COLS = 64
VIDEO_ROWS = 16

# ----------------------------------------------
# Build Directories
# ----------------------------------------------
SRC_DIR = src
BUILD_DIR = build
BIOS_DIR = $(SRC_DIR)/bios

# ----------------------------------------------
# Output Files
# ----------------------------------------------
SYSTEM_BIN = $(BUILD_DIR)/jx.bin
SYSTEM_HEX = $(BUILD_DIR)/jx.hex
